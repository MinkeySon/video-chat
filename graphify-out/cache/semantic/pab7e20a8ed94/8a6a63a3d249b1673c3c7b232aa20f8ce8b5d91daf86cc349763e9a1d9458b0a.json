{"nodes": [{"id": "readme", "label": "1:1 \ud654\uc0c1\ud1b5\ud654 \uc2dc\uadf8\ub110\ub9c1 \uc11c\ubc84 \ubb38\uc11c", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_signaling", "label": "Signaling (\uc2dc\uadf8\ub110\ub9c1)", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server only relays SDP/ICE; media flows P2P between devices, so server load stays minimal."}, {"id": "readme_webrtc_p2p", "label": "WebRTC P2P \uc5f0\uacb0", "file_type": "rationale", "source_file": "README.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For 1:1 calls P2P minimizes server load and latency; SFU would be overkill and is only needed for multi-party."}, {"id": "readme_sfu", "label": "SFU (\ubbf8\ub514\uc5b4 \uc11c\ubc84)", "file_type": "concept", "source_file": "README.md", "source_location": "L54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: suitable for multi-party but excessive for 1:1."}, {"id": "readme_socket_io", "label": "socket.io", "file_type": "concept", "source_file": "README.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over raw ws because rooms and reconnection are built in and RN/Flutter clients exist."}, {"id": "readme_raw_websocket", "label": "\uc21c\uc218 WebSocket (ws)", "file_type": "concept", "source_file": "README.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: lighter but requires implementing rooms and reconnection manually."}, {"id": "readme_sdp", "label": "SDP", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ephemeral connection data; not stored in DB to avoid latency and load."}, {"id": "readme_ice_candidate", "label": "ICE candidate", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ephemeral network path candidates; relayed immediately, not persisted."}, {"id": "readme_web_vs_app_clients", "label": "\uc6f9 vs \uc571 \ud074\ub77c\uc774\uc5b8\ud2b8 \ucc28\uc774", "file_type": "rationale", "source_file": "README.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server is identical for web and app since SDP/ICE are standard; only client rendering, permissions, background behavior differ."}, {"id": "readme_https_requirement", "label": "\ubaa8\ubc14\uc77c \uc6f9 HTTPS \ud544\uc218", "file_type": "rationale", "source_file": "README.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mobile browsers block camera without HTTPS (except localhost); tunnels like ngrok/cloudflared used for device testing."}, {"id": "readme_concurrent_join_problem", "label": "\ub3d9\uc2dc \uc785\uc7a5 \uc815\ud569\uc131 \ubb38\uc81c", "file_type": "concept", "source_file": "README.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_server_restart_problem", "label": "\uc11c\ubc84 \uc7ac\uc2dc\uc791 \uc2dc \uc794\uc5ec \uc0c1\ud0dc \ubb38\uc81c", "file_type": "concept", "source_file": "README.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_pessimistic_lock", "label": "\ube44\uad00\uc801 \ub77d (SELECT FOR UPDATE)", "file_type": "rationale", "source_file": "README.md", "source_locati